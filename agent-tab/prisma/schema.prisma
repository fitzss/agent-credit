generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Provider {
  id                  String        @id @default(uuid())
  name                String
  publicKey           String        @default("")
  privateKey          String        @default("")
  settlementPrefs     String        @default("manual")
  defaultDueDays      Int           @default(30)
  status              String        @default("active")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tools               Tool[]
  creditLines         CreditLine[]
  obligationStates    ObligationState[]
  usageEvents         UsageEvent[]
}

model Customer {
  id                  String        @id @default(uuid())
  name                String
  publicKey           String        @default("")
  privateKey          String        @default("") // empty = self-custody
  signingMode         String        @default("tracker") // tracker | self-custody
  contactEmail        String?
  defaultSettlementTerms String     @default("net30")
  status              String        @default("active")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  agentIdentities     AgentIdentity[]
  creditLines         CreditLine[]
  obligationStates    ObligationState[]
  usageEvents         UsageEvent[]
  delegations         Delegation[]
  reserves            Reserve[]
}

model AgentIdentity {
  id                  String        @id @default(uuid())
  customerId          String
  label               String
  apiKey              String        @unique @default(uuid())
  allowedToolIds      String        @default("*")
  status              String        @default("active")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer            Customer      @relation(fields: [customerId], references: [id])
  usageEvents         UsageEvent[]
  delegations         Delegation[]
}

model Tool {
  id                  String        @id @default(uuid())
  providerId          String
  name                String
  description         String        @default("")
  endpoint            String
  costPerCall         BigInt        // nanoCredits
  status              String        @default("active")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  provider            Provider      @relation(fields: [providerId], references: [id])
  usageEvents         UsageEvent[]
}

model CreditLine {
  id                  String        @id @default(uuid())
  providerId          String
  customerId          String
  limitAmount         BigInt        // nanoCredits
  alertThreshold      Float         @default(0.8)
  dueDays             Int           @default(30)
  status              String        @default("active")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  provider            Provider      @relation(fields: [providerId], references: [id])
  customer            Customer      @relation(fields: [customerId], references: [id])

  @@unique([providerId, customerId])
}

model Delegation {
  id                  String        @id @default(uuid())
  customerId          String
  agentIdentityId     String?       // null = legacy/unbound delegation
  sessionPubKey       String        // hex-encoded session public key
  scopeProviderIds    String        @default("*") // comma-separated or "*"
  scopeToolIds        String        @default("*") // comma-separated or "*"
  spendCap            BigInt        // nanoCredits — max cumulative spend under this delegation
  spentSoFar          BigInt        @default(0) // nanoCredits
  expiresAt           DateTime
  authMessage         String        // canonical delegation message signed by root key
  authSignature       String        // root key's signature on authMessage
  status              String        @default("active") // active | expired | revoked | exhausted
  createdAt           DateTime      @default(now())

  customer            Customer      @relation(fields: [customerId], references: [id])
  agentIdentity       AgentIdentity? @relation(fields: [agentIdentityId], references: [id])
  obligationUpdates   ObligationUpdate[]
}

model ObligationState {
  id                  String        @id @default(uuid())
  providerId          String
  customerId          String
  currentAmount       BigInt        @default(0) // nanoCredits — total committed A→B debt
  pendingAmount       BigInt        @default(0) // nanoCredits — proposed but unsigned
  version             Int           @default(0)
  debtorPubKey        String        @default("")
  creditorPubKey      String        @default("")
  latestSignedMessage String?
  latestSignature     String?
  settlementStatus    String        @default("current")
  lastUpdatedAt       DateTime      @default(now())
  createdAt           DateTime      @default(now())

  provider            Provider      @relation(fields: [providerId], references: [id])
  customer            Customer      @relation(fields: [customerId], references: [id])
  settlementEvents    SettlementEvent[]
  obligationUpdates   ObligationUpdate[]
  pendingRedemptions  PendingRedemption[]

  @@unique([providerId, customerId])
}

model ObligationUpdate {
  id                  String        @id @default(uuid())
  obligationStateId   String
  delegationId        String?       // which delegation authorized this (null = tracker-managed or manual)
  agentIdentityId     String?       // which authenticated agent advanced this debt
  version             Int
  previousAmount      BigInt        // nanoCredits
  newAmount           BigInt        // nanoCredits
  delta               BigInt        // nanoCredits
  canonicalMessage    String
  signature           String        @default("") // session or root signature
  signatureStatus     String        @default("signed") // signed | pending | rejected
  type                String        // "charge" | "settlement"
  nonce               String        @default(uuid()) // replay protection
  timestamp           DateTime      @default(now())

  obligationState     ObligationState @relation(fields: [obligationStateId], references: [id])
  delegation          Delegation?   @relation(fields: [delegationId], references: [id])
}

model Reserve {
  id                  String        @id @default(uuid())
  customerId          String
  debtorPubKey        String        // owner of the reserve
  reserveTokenId      String        @unique // Ergo singleton token ID
  trackerNftId        String        // which tracker NFT this reserve trusts
  boxId               String?       // current UTXO box ID on Ergo (updated by scanning)
  valueNanoErg        BigInt        @default(0) // current ERG collateral
  avlTreeDigest       String?       // current redeemed amounts tree digest
  creationHeight      Int?          // block height when reserve was created
  reserveAddress      String?       // Ergo address of the reserve contract
  // v1 = insert-only (one redemption per pair), v2 = insert+update (repeated same-pair)
  contractVersion     String        @default("v1") // v1 | v2
  // Reserve lifecycle: requested → submitted → active → depleted
  lifecycle           String        @default("requested") // requested | submitted | active | depleted
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer            Customer      @relation(fields: [customerId], references: [id])
  pendingRedemptions  PendingRedemption[]
}

model UsageEvent {
  id                  String        @id @default(uuid())
  agentIdentityId     String
  toolId              String
  providerId          String
  customerId          String
  amountCharged       BigInt        // nanoCredits
  timestamp           DateTime      @default(now())
  requestRef          String?
  outcome             String        @default("success")

  agentIdentity       AgentIdentity @relation(fields: [agentIdentityId], references: [id])
  tool                Tool          @relation(fields: [toolId], references: [id])
  provider            Provider      @relation(fields: [providerId], references: [id])
  customer            Customer      @relation(fields: [customerId], references: [id])
}

model SettlementEvent {
  id                  String        @id @default(uuid())
  obligationStateId   String
  amount              BigInt        // nanoCredits
  method              String        @default("manual")
  status              String        @default("completed")
  redemptionTxId      String?       @unique // on-chain tx ID for dedup (null for manual settlements)
  timestamp           DateTime      @default(now())

  obligationState     ObligationState @relation(fields: [obligationStateId], references: [id])
}

// Tracks on-chain redemption txs that were submitted but not yet confirmed/reconciled.
// Lifecycle: pending → reconciled | failed
model PendingRedemption {
  id                  String        @id @default(uuid())
  txId                String        @unique
  reserveId           String
  obligationId        String
  grossRedeemNanoErg  BigInt
  feeNanoErg          BigInt        @default(0)
  netPayoutNanoErg    BigInt        @default(0)
  status              String        @default("pending") // pending | reconciled | failed
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  reserve             Reserve       @relation(fields: [reserveId], references: [id])
  obligation          ObligationState @relation(fields: [obligationId], references: [id])
}

// Legacy model — kept for migration reference. Replaced by TrackerBox + TrackerEntry.
model TrackerDeployment {
  id                  String        @id @default(uuid())
  trackerNftId        String
  debtorPubKey        String
  creditorPubKey      String
  totalDebtNanoErg    BigInt
  boxId               String
  trackerPubKeyHex    String
  treeDigestHex       String
  txId                String?
  isCurrent           Boolean       @default(true)
  createdAt           DateTime      @default(now())

  @@index([trackerNftId, debtorPubKey, creditorPubKey, isCurrent])
}

// Represents an on-chain tracker box UTXO. The NFT ID is stable; the box rotates on each update.
model TrackerBox {
  id                  String         @id @default(uuid())
  trackerNftId        String         // stable across box rotations
  boxId               String         // current on-chain UTXO ID
  trackerPubKeyHex    String         // Schnorr pubkey in R4
  treeDigestHex       String         // R5 AVL tree digest
  txId                String?        // deployment/update tx ID
  isCurrent           Boolean        @default(true)
  createdAt           DateTime       @default(now())

  entries             TrackerEntry[]

  @@index([trackerNftId, isCurrent])
}

// One entry per (debtor, creditor) pair in a tracker box's AVL tree.
model TrackerEntry {
  id                  String         @id @default(uuid())
  trackerBoxId        String
  debtorPubKey        String
  creditorPubKey      String
  totalDebtNanoErg    BigInt         // cumulative debt committed for this pair

  trackerBox          TrackerBox     @relation(fields: [trackerBoxId], references: [id])

  @@unique([trackerBoxId, debtorPubKey, creditorPubKey])
}

// Records a debt transfer (novation): move X from debt(A→B) to debt(A→C).
// Debtor A must be the same for both obligations.
model DebtTransfer {
  id                  String          @id @default(uuid())
  fromObligationId    String
  toObligationId      String
  amountCredits       BigInt          // nanoCredits — transfer amount
  amountNanoErg       BigInt          // same amount in chain-native units for audit
  debtorPubKey        String          // A's key (same for both obligations)
  fromCreditorPubKey  String          // B's key
  toCreditorPubKey    String          // C's key
  status              String          @default("completed")
  createdAt           DateTime        @default(now())
}
