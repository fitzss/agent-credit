# Agent Tab MCP Gateway — environment template (Slice 12a).
#
# Copy this file to a real env source (e.g. shell `export ...`, a process
# manager config, or a private .env loaded by the MCP host). Never commit
# real values.

# Required: where Agent Tab is running.
AGENT_TAB_BASE_URL=http://localhost:3000

# Required: raw API key for the MCP demo agent.
# Obtain by running `npx tsx scripts/seed-mcp-demo.ts` (printed once to stdout).
# NEVER paste a real key into this file in version control.
AGENT_TAB_AGENT_KEY=replace-with-key-from-seed-script

# Required: tool id the gateway will forward calls to.
AGENT_TAB_TOOL_ID=auth-demo-tool-analyze-001

# Optional: HTTP timeout in ms (default 15000).
# AGENT_TAB_TIMEOUT_MS=15000

# Optional: name the model sees for the wrapped tool (default analyze_text).
# AGENT_TAB_MCP_TOOL_NAME=analyze_text
